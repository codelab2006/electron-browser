{
  "name": "application-cilent",
  "version": "1.0.0",
  "description": "N/A",
  "main": "main.js",
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.19.1"
  },
  "scripts": {
    "postinstall": "node -e \"process.env.ELECTRON_MIRROR ||= 'https://npmmirror.com/mirrors/electron/'; require('electron/install.js')\"",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:windows": "electron-forge make --platform=win32 --arch=x64",
    "make:linux": "electron-forge make --platform=linux --arch=x64"
  },
  "author": "...",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "electron": "45.0.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true,
        "extraResource": ["resources/config.json"],
        "ignore": ["^/resources/config\\.json$"],
        "download": {
          "mirrorOptions": {
            "mirror": "https://npmmirror.com/mirrors/electron/"
          }
        }
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32",
            "linux"
          ]
        }
      ]
    }
  }
}
